    {"id": "empty-set-latex-key", "key": "\\varnothing", "accept": ["\\varnothing", "∅", "\\emptyset", "$\\varnothing$", "нет корней", "Нет корней.", "корней нет", "нет решений", "решений нет", "пустое множество", "x \\in \\varnothing"], "reject": ["0", "{0}", "один корень", "нет корней и всё же есть"]},
    {"id": "empty-set-words-key", "key": "нет корней", "accept": ["нет корней", "Нет корней", "корней нет", "\\varnothing", "∅", "\\emptyset"], "reject": ["0", "5"]},
    {"id": "number-is-not-empty", "key": "5", "accept": ["5", "5.0"], "reject": ["нет корней", "\\varnothing", "∅", "10/2"]},
