    {"id": "latex-fraction-key", "key": "\\dfrac{21}{5}", "accept": ["21/5", "\\dfrac{21}{5}", "\\frac{21}{5}", "4,2", "4.2"], "reject": ["21/6", "4,3", "\\frac{21}{6}", "42/10"]},
    {"id": "decimal-comma-key", "key": "4,2", "accept": ["4,2", "4.2", "21/5", "\\frac{21}{5}"], "reject": ["4,3", "42", "2,4", "42/10"]},
    {"id": "half", "key": "0.5", "accept": ["0.5", "0,5", "1/2", "\\frac{1}{2}"], "reject": ["0.51", "1/3", "5", "2/4", ".5"]},
    {"id": "negative", "key": "-3", "accept": ["-3", "−3", "-3.0"], "reject": ["3", "-2", "- 3 3", "-6/2"]},
