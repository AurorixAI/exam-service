# Exam Service — Environment Variables
# Copy to .env and fill in real values

# App
APP_ENV=production  # development | production | testing
DEBUG=false

# Database — own DB for exams/results
DATABASE_URL=postgresql://algo:algo_password@localhost:5432/algo_exam

# Content DB — read-only source (ideally replace with content-service HTTP API)
CONTENT_DB_URL=postgresql://algo:algo_password@localhost:5434/algo_content

# Redis (template cache)
REDIS_URL=redis://localhost:6379
REDIS_TEMPLATE_CACHE_TTL=3600

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Exam parameters
MAX_TASKS_PER_EXAM=50
MAX_VARIANTS=30
DEFAULT_TIME_MINUTES=45

# CORS (comma-separated if overriding via env)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
