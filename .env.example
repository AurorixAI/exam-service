# Exam Service — Environment Variables
# Copy to .env and fill in real values

# App
APP_ENV=development  # development | production | testing
DEBUG=false

# Database — exam service owns only this DB
DATABASE_URL=postgresql://algo:algo_password@localhost:5432/algo_exam

# Content Service — HTTP API (no direct DB access to content-db)
CONTENT_SERVICE_URL=http://content-service:8004
AUTH_SERVICE_URL=http://auth-service:8000
# Shared with auth-service only; use a long random value outside local dev.
INTERNAL_SERVICE_TOKEN=

# Redis (template cache)
REDIS_URL=redis://localhost:6379
REDIS_TEMPLATE_CACHE_TTL=3600

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Emergency switch for ALL paid report-narrative model calls (default true = on).
# false / 0 / no / off -> the exam report is built deterministically with 0 paid calls.
REPORT_NARRATIVE_ENABLED=true

# Exam parameters
MAX_TASKS_PER_EXAM=50
MAX_VARIANTS=30
DEFAULT_TIME_MINUTES=45
