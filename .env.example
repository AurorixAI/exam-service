# Exam Service — Environment Variables
# Copy to .env and fill in real values

# App
APP_ENV=development  # development | production | testing
DEBUG=false

# Database — exam service owns only this DB
DATABASE_URL=postgresql://algo:algo_password@localhost:5432/algo_exam

# Content Service — HTTP API (no direct DB access to content-db)
CONTENT_SERVICE_URL=http://content-service:8004

# Redis (template cache)
REDIS_URL=redis://localhost:6379
REDIS_TEMPLATE_CACHE_TTL=3600

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Exam parameters
MAX_TASKS_PER_EXAM=50
MAX_VARIANTS=30
DEFAULT_TIME_MINUTES=45
